[Unit]
Description=CAKB RAG Pipeline & Query API
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/knowledge-base
ExecStart=/opt/knowledge-base/venv/bin/python3 /opt/knowledge-base/dashboard.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/opt/knowledge-base/logs/dashboard.log
StandardError=append:/opt/knowledge-base/logs/dashboard.log

# Environment
Environment=PATH=/usr/bin:/usr/local/bin:/opt/knowledge-base/venv/bin
Environment=TMPDIR=/opt/knowledge-base/data/tmp
EnvironmentFile=/opt/knowledge-base/.env

# Security
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/knowledge-base/logs /opt/knowledge-base/rag /opt/knowledge-base/data /opt/knowledge-base/.rag_pipeline.lock

[Install]
WantedBy=multi-user.target
